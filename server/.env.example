# Copy this file to .env and fill in real values. Never commit .env.

NODE_ENV=development
PORT=5000

# Origin(s) allowed to call the API from a browser (comma-separated).
# In development this is the Vite dev server.
CLIENT_ORIGIN=http://localhost:5173

# Set to true to serve the built React app (client/dist) from this server,
# so the whole site runs on one host. Leave false if the frontend is hosted separately.
SERVE_CLIENT=false

# Set to 1 when running behind a reverse proxy / load balancer (Render, Railway,
# Nginx, etc.) so rate limiting sees the real client IP.
TRUST_PROXY=0

# --- MySQL ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=portfolio_app
DB_PASSWORD=change-me
DB_NAME=james_namata_portfolio
# Set to true if your hosted MySQL requires TLS
DB_SSL=false

# --- Email notifications (SMTP) ---
# Leave SMTP_HOST empty to skip sending email (submissions are still saved and logged).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# Address that receives new inquiry notifications
NOTIFY_EMAIL=you@example.com
# "From" address (must be allowed by your SMTP provider)
MAIL_FROM="James Namata Website <no-reply@yourdomain.com>"

# --- Spam protection ---
# Reject forms submitted faster than this many milliseconds after the page opened
MIN_FORM_FILL_MS=3000
